<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="ASK Block"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".BlockProvider"
            android:authorities="com.dani.askblock.settings"
            android:exported="true" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposeddescription"
            android:value="Turns off AnySoftKeyboard suggestions and autocorrect for chosen apps (e.g. Termux)." />
        <meta-data
            android:name="xposedscope"
            android:value="com.menny.android.anysoftkeyboard" />
    </application>
</manifest>
